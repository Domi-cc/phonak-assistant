# build output: the build folder of the project and of each module, and nothing below that.
# A plain "build/" would also hide a source package of that name, without a word.
/build/
/*/build/
.gradle/
.kotlin/
*.apk
*.aab

# machine-specific
local.properties
.idea/
*.iml

# private: research notes, device captures, signing key (never commit)
.local/
*.jks
*.keystore
keystore.properties
