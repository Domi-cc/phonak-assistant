<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- For announcements at a set time (hourly test, calendar reminders). Granted at install. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- For the spoken reminders before appointments. Asked for when the owner switches them
         on; until then the app reads nothing from the calendar. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Declared only to learn something: the journal line `volume_state` says whether Android
         grants this to a sideloaded app that holds the assistant role. It would let an app set
         Android's assistant volume. The app does not use it in this build and sets that
         volume nowhere. -->
    <uses-permission
        android:name="android.permission.MANAGE_ASSISTANT_AUDIO"
        tools:ignore="ProtectedPermissions" />
    <!-- Development permission. Has no effect until the owner runs:
         adb shell pm grant io.github.domicc.lara android.permission.SET_MEDIA_KEY_LISTENER -->
    <uses-permission
        android:name="android.permission.SET_MEDIA_KEY_LISTENER"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Needed to see which app Android would start for the hearing-aid voice button. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <!-- The phone's speech engine writes the spoken phrases into files and speaks the
             unprompted announcements. This entry makes sure the app may see it. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- The Bluetooth stack is updated apart from the system. Its version goes into the
             journal; these entries make sure the app may look it up. -->
        <package android:name="com.google.android.bt" />
        <package android:name="com.android.bt" />
    </queries>

    <application
        android:name=".LaraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Input path A: the hearing-aid tap. Android's Bluetooth stack turns the hands-free
             "voice recognition" request into an activity start with VOICE_COMMAND; the assistant
             role is not involved in routing it. The owner picks this activity once as "Always".
             NEVER rename or disable this component: Android silently drops the "Always" choice. -->
        <activity
            android:name=".trigger.VoiceCommandActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The three services below make the app selectable as digital assistant. All three are
             required: without the recognition service Android clears the assistant setting again.
             While the system keeps the first one bound, the app may use the microphone and play
             audio from the background. -->
        <service
            android:name=".assistant.LaraVoiceInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".assistant.LaraSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".assistant.LaraRecognitionService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Alarm target for the hourly test announcement. -->
        <receiver
            android:name=".announce.HourlyReceiver"
            android:exported="false" />

        <!-- Alarm target for the calendar reminders: a reminder falls due, or it is time to
             read the calendar again. -->
        <receiver
            android:name=".calendar.CalendarAlarmReceiver"
            android:exported="false" />

        <!-- One spoken interaction with the hearing aid. Runs only while a session is active. -->
        <service
            android:name=".audio.SessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Input path B: the Shelly remote. Runs all the time and owns the Bluetooth scan.
             Android rates an app with a foreground service as foreground for scanning. -->
        <service
            android:name=".shelly.ListenerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Starts the listener after boot (sent after the first unlock: the app is not
             direct-boot aware) and after an update, and takes its periodic alarm. Not exported:
             Android itself may still deliver to it. -->
        <receiver
            android:name=".shelly.ListenerStarter"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Target of the optional rescue scan. Must be declared here and not registered at
             run time: the Bluetooth stack delivers to it when the app's process is gone. -->
        <receiver
            android:name=".shelly.RescueScanReceiver"
            android:exported="false" />

        <!-- Control from a computer for repeatable measurements, see docs/adb-control.md.
             Exported, because the adb shell is another app to Android. The permission is what
             keeps everybody else out: the shell holds DUMP, and an ordinary app gets it only if
             the owner grants it over adb himself. No intent filter: commands name this
             component. -->
        <receiver
            android:name=".control.AdbReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Lets the app chosen in the share sheet read the journal files the owner shares, and
             nothing else: res/xml/shared_files.xml names the one directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

    </application>
</manifest>
